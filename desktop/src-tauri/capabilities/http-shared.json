{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "http-shared",
  "description": "plugin-http allow-list shared by the main and lyric windows (music APIs). Window-specific extras stay in each window's own capability; scopes from all capabilities matching a window are merged.",
  "windows": ["main", "lyric"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://music.163.com/*" },
        { "url": "http://*.music.163.com/*" },
        { "url": "https://music.163.com/*" },
        { "url": "https://*.music.163.com/*" },
        { "url": "https://music-api.gdstudio.xyz/*" },
        { "url": "https://c.y.qq.com/*" },
        { "url": "https://y.qq.com/*" },
        { "url": "https://u.y.qq.com/*" },
        { "url": "https://*.y.qq.com/*" }
      ]
    }
  ]
}
