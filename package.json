{
  "name": "auralflow",
  "private": true,
  "version": "0.6.16",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "core:typecheck": "pnpm --filter @lx/core typecheck",
    "core:test": "pnpm --filter @lx/core test",
    "mobile:start": "pnpm --filter @auralflow/mobile start",
    "mobile:android": "pnpm --filter @auralflow/mobile android",
    "mobile:build:debug": "pnpm --filter @auralflow/mobile android:assembleDebug",
    "mobile:build:release": "pnpm --filter @auralflow/mobile android:assembleRelease",
    "mobile:typecheck": "pnpm --filter @auralflow/mobile typecheck",
    "mobile:lint": "pnpm --filter @auralflow/mobile lint",
    "desktop:dev": "pnpm --filter @auralflow/desktop dev",
    "desktop:build": "pnpm --filter @auralflow/desktop build",
    "desktop:typecheck": "pnpm --filter @auralflow/desktop typecheck",
    "desktop:tauri": "pnpm --filter @auralflow/desktop tauri",
    "desktop:tauri:dev": "pnpm --filter @auralflow/desktop tauri:dev",
    "desktop:tauri:build": "pnpm --filter @auralflow/desktop tauri:build",
    "test:core": "pnpm --filter @lx/core test",
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "check:all": "pnpm core:typecheck && pnpm desktop:typecheck && pnpm mobile:typecheck && pnpm mobile:lint",
    "test:all": "pnpm check:all && pnpm mobile:test && pnpm test:core && pnpm test:desktop && pnpm test:rust",
    "test": "pnpm test:all",
    "test:desktop": "pnpm --filter @auralflow/desktop test",
    "mobile:test": "pnpm --filter @auralflow/mobile test"
  }
}
